{
  "name": "dsh-plugin-memory-lite",
  "version": "1.4.0",
  "description": "给 DSH 的本地优先跨会话记忆：每轮自动沉淀 + 空闲自动整理 + 按需注入。重点是注入纪律（压缩后补回、不重复注入、敏感内容不注入、删改走审批）。数据全部存在本地 SQLite，不联网、不上传。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "cross-session",
    "sqlite",
    "memory-lite"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "icon": "icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eighteentang/dsh-plugin-memory-lite.git"
  },
  "bugs": {
    "url": "https://github.com/eighteentang/dsh-plugin-memory-lite/issues"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
